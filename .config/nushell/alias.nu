# EZA
export alias la = eza -lhaF --git --icons --group-directories-first --time-style=long-iso
export alias lt = eza -aT --git --icons --group-directories-first --level=2

# GIT
export alias ga = git add
export alias gb = git branch
export alias gba = git branch --all
export alias gc = git commit --verbose
export alias gco = git checkout
export alias gcb = git checkout -b
export alias gd = git diff
export alias gf = git fetch
export alias gs = git status
